# El Hincha · variables de entorno (PLANTILLA, sin valores reales).
#
# En Netlify: Site configuration → Environment variables. Marca «Contains secret values»
# en las que dicen SECRETA.
# En tu PC (opcional, para probar contra Supabase): copia este archivo como `.env.local`
# y complétalo. `.env.local` está en .gitignore y el candado pre-commit lo bloquea.
# Sin estas variables, en local la app usa datos de prueba en memoria.
#
# NUNCA uses el prefijo NEXT_PUBLIC_ en estas variables: lo que lleva ese prefijo
# viaja al navegador de cualquier visitante.

# Supabase → Project Settings → API → Project URL. No es secreta.
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase → Project Settings → API → llave «service_role». SECRETA.
# Da acceso total a la base: solo en Netlify / .env.local, jamás en el código ni en chats.
SUPABASE_SERVICE_ROLE_KEY=

# Generadas con `pnpm clave-admin`. SECRETAS.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Dominio público de la tienda, para clasificar de dónde llegan las visitas. No es secreta.
SITIO_HOST=elhincha.netlify.app
